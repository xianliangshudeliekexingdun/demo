extends RefCounted
const Config=preload("res://scripts/core/trial_config.gd")
const Battle=preload("res://scripts/core/trial_battle.gd")
const Stats=preload("res://scripts/core/fireball_stats.gd")
var failures=0
var checks=0
var cfg: Dictionary
func check(ok: bool,message: String):
	checks+=1
	if not ok:
		failures+=1
		push_error("Fireball trial: "+message)
func near(a: float,b: float) -> bool: return absf(a-b)<0.0001
func advance(b,seconds: float):
	for i in range(roundi(seconds*120)): b.advance(Battle.STEP,Vector2.ZERO,Vector2(3,0))
func start(b):
	b.queue("press")
	advance(b,Battle.STEP)
func run() -> int:
	var loader=Config.new()
	check(loader.load_table(),"default CSV valid: "+loader.error)
	if loader.values.is_empty(): return failures
	cfg=loader.values
	for mask in range(64):
		var ids=[]
		for i in range(6):
			if mask&(1<<i): ids.append(Stats.IDS[i])
		var a=Stats.compute(cfg,ids)
		var doubled=Stats.compute(cfg,ids+ids)
		check(a==doubled,"upgrade set idempotent %d" % mask)
		var b=Battle.new(cfg)
		b.set_owned(ids)
		check(b.stats()==a,"effective attributes %d" % mask)
		b.set_owned([])
		check(b.stats()==Stats.compute(cfg,[]),"remove upgrades %d" % mask)
	var all=Stats.compute(cfg,Stats.IDS,true)
	check(near(all.damage,66) and near(all.cost,25) and near(all.radius,2.145),"combined molten formulas")
	var b=Battle.new(cfg)
	b.player.mana=1
	start(b)
	check(b.phase=="idle" and b.summary.released==0,"insufficient basic mana prevents chant")
	b=Battle.new(cfg)
	start(b)
	advance(b,0.8-Battle.STEP)
	b.queue("release")
	advance(b,Battle.STEP)
	check(b.summary.released==1,"release at exact chant completion")
	b=Battle.new(cfg)
	start(b)
	advance(b,0.8-2*Battle.STEP)
	b.queue("release")
	advance(b,Battle.STEP)
	check(b.summary.released==0,"release one tick before completion")
	b=Battle.new(cfg)
	start(b)
	advance(b,0.4)
	b.queue("release")
	advance(b,Battle.STEP)
	check(b.summary.released==0 and b.player.mana==cfg["mana.max"] and b.phase=="idle","early release cancels without mana")
	start(b)
	advance(b,0.8)
	check(b.phase=="ready" and b.summary.released==0,"hold ready without firing")
	b.queue("release")
	advance(b,Battle.STEP)
	check(b.summary.released==1 and near(b.player.mana,82),"release once and debit")
	b.queue("release")
	advance(b,0.45)
	check(b.summary.released==1 and b.summary.landed==1,"flight fixed and repeated release ignored")
	advance(b,0.6)
	check(b.player.mana>82,"delayed regeneration")
	b=Battle.new(cfg)
	start(b)
	advance(b,0.56)
	var progress=b.chant
	b.queue("dodge")
	advance(b,Battle.STEP)
	var health=b.player.health
	b.damage_player(15)
	check(b.player.health==health and not b.saved.is_empty(),"invulnerability preserves saved cast")
	while b.phase=="dodging": advance(b,Battle.STEP)
	check(b.phase=="chanting" and near(b.player.pos.length(),cfg["dodge.distance"]),"held cast auto resumes at dodge end")
	check(near(b.chant,progress) and b.summary.auto_resumed==1 and b.summary.released==0,"auto resume preserves 70 percent without firing")
	b.damage_player(15)
	check(b.phase=="idle" and b.saved.is_empty() and near(b.player.health,85),"actual hit clears")
	b=Battle.new(cfg)
	start(b)
	advance(b,0.3)
	b.queue("dodge")
	advance(b,Battle.STEP)
	b.queue("release")
	advance(b,0.8)
	check(b.phase=="idle" and b.summary.timeouts==1,"resume timeout")
	for offset in [0.0,Battle.STEP]:
		b=Battle.new(cfg)
		b.phase="resume_window"
		b.saved={"phase":"ready","chant":cfg["fireball.chant_time"],"extra":0.0}
		b.window_end=0.1
		b.elapsed=0.1+offset
		if offset>0: b.cancel("resume_timeout")
		b.press()
		check(b.phase==("ready" if offset==0 else "chanting"),"resume deadline inclusive or fresh after expiry")
	b=Battle.new(cfg)
	b.set_owned(["molten"])
	start(b)
	advance(b,1.0)
	var extra_progress=b.extra
	b.queue("dodge")
	advance(b,Battle.STEP)
	while b.phase=="dodging": advance(b,Battle.STEP)
	check(b.phase=="charging_molten" and near(b.extra,extra_progress),"molten partial stage auto resumes")
	b=Battle.new(cfg)
	start(b)
	advance(b,.8)
	b.queue("dodge")
	advance(b,Battle.STEP)
	while b.phase=="dodging": advance(b,Battle.STEP)
	check(b.phase=="ready" and b.summary.released==0 and near(b.player.mana,100),"ready auto restores without firing or debit")
	b.queue("release")
	advance(b,Battle.STEP)
	check(b.summary.released==1,"ready still requires release after auto resume")
	b=Battle.new(cfg)
	start(b)
	advance(b,.4)
	progress=b.chant
	b.queue("dodge")
	advance(b,Battle.STEP)
	b.queue("release")
	advance(b,Battle.STEP)
	while b.phase=="dodging": advance(b,Battle.STEP)
	check(b.phase=="resume_window" and b.summary.resumed==0,"release during dodge leaves manual window")
	b.queue("press")
	advance(b,Battle.STEP)
	check(near(b.chant,progress) and b.summary.resumed==1 and b.summary.auto_resumed==0,"manual window still preserves progress")
	b=Battle.new(cfg)
	start(b)
	advance(b,.4)
	b.queue("dodge")
	advance(b,Battle.STEP)
	b.queue("release")
	advance(b,Battle.STEP)
	b.queue("press")
	advance(b,Battle.STEP)
	while b.phase=="dodging": advance(b,Battle.STEP)
	check(b.summary.auto_resumed==1,"rehold during dodge resumes when it ends")
	b=Battle.new(cfg)
	start(b)
	advance(b,.4)
	b.queue("dodge")
	advance(b,Battle.STEP)
	advance(b,.14)
	b.damage_player(15)
	advance(b,.1)
	check(b.phase=="idle" and b.summary.resumed==0,"actual hit prevents held auto continuation")
	b=Battle.new(cfg)
	b.set_owned(["molten"])
	b.player.mana=20
	start(b)
	advance(b,1.5)
	check(b.phase=="ready" and near(b.extra,0),"insufficient molten mana stays ordinary")
	b.queue("release")
	advance(b,Battle.STEP)
	check(b.summary.released==1 and not b.bullets[0].stats.enhanced,"normal release when molten unavailable")
	b=Battle.new(cfg)
	b.set_owned(Stats.IDS)
	start(b)
	advance(b,1.2)
	check(b.phase=="ready_molten","legendary second stage ready")
	b.queue("release")
	advance(b,Battle.STEP)
	var snapshot=b.bullets[0].stats.duplicate()
	b.set_owned([])
	check(b.bullets[0].stats==snapshot,"in flight snapshot survives upgrade change")
	b.pause()
	var old=b.elapsed
	b.advance(0.1,Vector2.RIGHT,Vector2.ZERO)
	check(b.elapsed==old and b.phase=="idle" and not b.held,"pause freezes and clears unspent cast")
	b.paused=false
	b.queue("release")
	advance(b,Battle.STEP)
	check(b.summary.released==1,"release after pause cannot fire")
	b=Battle.new(cfg)
	start(b)
	advance(b,0.8)
	b.queue("release")
	advance(b,Battle.STEP)
	var locked: Vector2=b.bullets[0].target
	b.advance(.1,Vector2.LEFT,Vector2(-8,4))
	check(b.bullets[0].target==locked and b.summary.landed==0,"released target stays locked despite aim movement")
	var x=Battle.new(cfg)
	var y=Battle.new(cfg)
	x.queue("press")
	y.queue("press")
	for i in range(120): x.advance(1.0/120,Vector2.RIGHT,Vector2(5,0))
	for i in range(30): y.advance(1.0/30,Vector2.RIGHT,Vector2(5,0))
	check(near(x.chant,y.chant) and x.player.pos.distance_to(y.player.pos)<0.0001,"fixed step render partition independent")
	x=Battle.new(cfg,1)
	x.enemies[0].state="recover"
	x.enemies[0].until=100
	x.enemies[0].pos=Vector2(1.4+cfg["enemy.radius"],0)
	x.blast(Vector2.ZERO,x.stats(),1)
	check(near(x.enemies[0].health,30),"circle boundary hit once")
	x=Battle.new(cfg,1)
	x.enemies[0].state="attack"
	x.enemies[0].start=Vector2(-1,0)
	x.enemies[0].pos=Vector2(-1,0)
	x.enemies[0].aim=Vector2.RIGHT
	x.enemies[0].until=x.elapsed+cfg["enemy.lunge_time"]
	advance(x,0.3)
	check(x.summary.hits==1,"swept lunge once")
	x=Battle.new(cfg,1)
	x.enemies[0].state="recover"
	x.enemies[0].until=100
	x.enemies[0].health=1000
	x.enemies[0].pos=Vector2.ZERO
	x.set_owned(["embers","echo"])
	x.blast(Vector2.ZERO,x.stats(),1)
	x.blast(Vector2.ZERO,x.stats(),2)
	advance(x,3.1)
	check(near(x.summary.damage,60+30+24) and x.echoes.is_empty() and x.burns.is_empty(),"two main two echo three shared burn ticks no recursion")
	x=Battle.new(cfg,1,true)
	y=Battle.new(cfg,1,true)
	check(x.draw_choices()==y.draw_choices(),"seed deterministic")
	x.owned=Stats.IDS.slice(0,5)
	check(x.draw_choices()==["molten"],"candidate exhaustion")
	x.enemies[0].health=0
	advance(x,Battle.STEP)
	check(x.result=="choice","wave requests choice")
	if not x.choices.is_empty(): x.choose(x.choices[0])
	check(x.wave==2 and x.enemies.size()==2 and x.result=="playing","wave continuation")
	for e in x.enemies: e.health=0
	advance(x,Battle.STEP)
	x.choose(x.choices[0] if not x.choices.is_empty() else "")
	check(x.wave==3 and x.enemies.size()==3,"third stage count")
	for e in x.enemies: e.health=0
	advance(x,Battle.STEP)
	check(x.result=="success","final stage success")
	var zero_cfg=cfg.duplicate()
	zero_cfg["choice.legendary_weight"]=0
	x=Battle.new(zero_cfg)
	x.owned=Stats.IDS.slice(0,5)
	check(x.draw_choices().is_empty() and x.result=="config_error","zero remaining weight fails explicitly")
	for count in range(4): check(Battle.new(cfg,count).enemies.size()==count,"free enemy count %d" % count)
	x=Battle.new(cfg)
	var record=preload("res://scripts/core/trial_records.gd").new(cfg)
	x.emit("test",{"point":Vector2(2,3)})
	record.finish(x)
	var parsed=JSON.parse_string(FileAccess.get_file_as_string(record.path+"-summary.json"))
	check(parsed.resume_rate==null and parsed.hit_rate==null,"no attempts reported as no data")
	check(FileAccess.get_file_as_string(record.path+".jsonl").contains('"point":[2.0,3.0]'),"local vector record structured")
	# Invalid CSV must preserve last known good configuration.
	var source=FileAccess.get_file_as_string(Config.PATH)
	DirAccess.make_dir_recursive_absolute("res://build/qa/fireball-trial")
	var tuned=FileAccess.open("res://build/qa/fireball-trial/tuned.csv",FileAccess.WRITE)
	tuned.store_string(source.replace("fireball.chant_time,0.8","fireball.chant_time,1.1"))
	tuned.close()
	var tuned_loader=Config.new()
	check(tuned_loader.load_table("res://build/qa/fireball-trial/tuned.csv") and near(Stats.compute(tuned_loader.values,["quick_chant"]).chant,0.89375),"table edits drive effective chant")
	for bad in [source+"player.health_max,100,int,点,1,10000,重复\n",source.replace("fireball.chant_time,0.8","fireball.chant_time,NaN"),source.replace("dodge.invulnerable_time,0.12","dodge.invulnerable_time,0.9"),source.replace("enemy.damage,15.0,float,点,0,10000,一次扑击伤害\n", ""),source.replace("enemy.damage,","unknown.damage,")]:
		var f=FileAccess.open("res://build/qa/fireball-trial/invalid.csv",FileAccess.WRITE)
		f.store_string(bad)
		f.close()
		check(not loader.load_table("res://build/qa/fireball-trial/invalid.csv") and loader.values==cfg,"atomic config validation")
	print("Fireball trial checks=",checks," failures=",failures)
	return failures
